.DS_Store
.dart_tool/
.packages
build/
*.iml
.idea/
pubspec.lock
third_party/*.tgz
third_party/filament-*/

# spike build artefacts
spike/spike
spike/lit.filamat
spike/spike_output.png

# Built by packages/orblit_filament/darwin/setup.sh: the fetched SDK, the
# materials compiled out of it, and the one framework Swift Package Manager
# takes in place of the SDK's twenty archives.
packages/orblit_filament/darwin/third_party/
packages/orblit_filament/darwin/orblit_filament/third_party/
# Swift Package Manager's cache, made by any build that resolves the package.
packages/orblit_filament/darwin/orblit_filament/.build/
packages/orblit_filament/darwin/orblit_filament/Sources/orblit_filament_native/generated/

# Staged by packages/orblit_filament/linux/setup.sh and windows/setup.sh: the
# Filament Linux and Windows releases, either fetched here or symlinked from
# the project's own cache. The materials they compile land in darwin/'s
# generated/ directory, which is already ignored above -- see those scripts
# for why the platforms share one.
packages/orblit_filament/linux/third_party/
packages/orblit_filament/windows/third_party/

# Flutter
.flutter-plugins-dependencies
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
# Written by the Flutter tool from the resolved plugin list on every build,
# exactly as macOS's GeneratedPluginRegistrant.swift is, and ignored here for
# the same reason: it is output, and a machine that resolves a different set
# of plugins otherwise shows it as a change nobody made.
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/macos/Pods/
**/macos/Podfile.lock
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
*.iml

# Fetched by tool/fetch_bistro.sh: a CC BY 4.0 test scene, not ours to ship.
assets/bistro/
assets/samples/
# Written by tool/cook_textures.sh beside whatever folder it cooks: output,
# rebuilt from its sources whenever they change.
*.cooked/

# Fetched by packages/orblit_filament/native/texture_cook/fetch.sh: Basis
# Universal and stb, pinned by commit and checked against sources.sha256.
packages/orblit_filament/native/texture_cook/third_party/

# Built by packages/orblit_filament/native/web/build.sh: object files, and the
# Emscripten module it links, served straight out of host/ alongside the
# static index.html/main.js that stay committed.
packages/orblit_filament/native/web/build/
packages/orblit_filament/native/web/host/orblit_renderer.js
packages/orblit_filament/native/web/host/orblit_renderer.wasm
packages/orblit_filament/native/web/captures/

# Fetched by tool/check_gltf.sh: the Khronos glTF-Validator, which is the
# reference implementation and not ours to vendor.
node_modules/
