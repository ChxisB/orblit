<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.42.1</Version>
    <Description>The Orblit renderer over its C API. A scene is described in whole batches and drawn by Filament.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.Interop\Orblit.Interop.csproj" />
    <ProjectReference Include="..\Orblit.Json\Orblit.Json.csproj" />
    <ProjectReference Include="..\Orblit.VectorMath\Orblit.VectorMath.csproj" />
    <InternalsVisibleTo Include="Orblit.Filament.Tests" />
  </ItemGroup>
  <!-- The renderer, built by tool/build_native.sh when a Filament release is present. It flows to every project that references this one, and into the package. -->
  <ItemGroup>
    <Content Include="..\native\runtimes\**\*orblit_filament*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
