<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Description>Plays an Orblit.Audio game on a real output device. A native library over miniaudio decodes WAV, FLAC, MP3 and Ogg Vorbis, and streams long files.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.Audio\Orblit.Audio.csproj" />
    <ProjectReference Include="..\Orblit.Interop\Orblit.Interop.csproj" />
  </ItemGroup>
  <!-- The native device, built by tool/build_native.sh. It flows to every project that references this one, and into the package. -->
  <ItemGroup>
    <Content Include="..\native\runtimes\**\*orblit_audio_device*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
