<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.Filament\Orblit.Filament.csproj" />
    <ProjectReference Include="..\Orblit.Parity\Orblit.Parity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\fixtures\orblit_filament\*.json" Link="fixtures\orblit_filament\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The C header is the contract the declarations are checked against. -->
  <ItemGroup>
    <Content Include="..\..\packages\orblit_filament\darwin\orblit_filament\Sources\orblit_filament_native\include\orblit_renderer.h" Link="orblit_renderer.h" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Two native sources are read as text, for the effect numbering and the order of one pass. -->
  <ItemGroup>
    <Content Include="..\..\packages\orblit_filament\darwin\orblit_filament\Sources\orblit_filament_native\OrblitRendererTypes.h" Link="native\OrblitRendererTypes.h" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packages\orblit_filament\darwin\orblit_filament\Sources\orblit_filament_native\OrblitMotionBlur.cpp" Link="native\OrblitMotionBlur.cpp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
