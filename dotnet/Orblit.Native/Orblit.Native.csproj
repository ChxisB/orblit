<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Description>Compiling and loading C++ scripts. A script is handed a table of what it may call and answers start, step and stop.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.Core\Orblit.Core.csproj" />
    <ProjectReference Include="..\Orblit.Interop\Orblit.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orblit.Native.Tests" />
  </ItemGroup>
  <!-- The headers a script is compiled against, beside the assembly where ScriptRunner.EngineIncludes looks. -->
  <ItemGroup>
    <Content Include="..\..\packages\orblit_native\include\orblit_script.h" Link="include\orblit_script.h" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="include\" />
    <Content Include="..\..\packages\orblit_core\include\orblit_core.h" Link="include\orblit_core.h" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="include\" />
  </ItemGroup>
</Project>
