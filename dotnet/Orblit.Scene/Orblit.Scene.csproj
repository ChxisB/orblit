    <ProjectReference Include="..\Orblit.Weather\Orblit.Weather.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orblit.Scene.Tests" />
  </ItemGroup>
</Project>
