<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.10.0</Version>
    <Description>Animation clips, blends and cutscenes. A clip is channels of keys, each addressed by a path and a property, played on a scene's entities and a model's bones alike. A blend is a graph of states that mixes and fades between them. A cutscene keys the scene as a whole and cuts between cameras. A clip made for one skeleton can be retargeted onto another's proportions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.Json\Orblit.Json.csproj" />
    <ProjectReference Include="..\Orblit.Scene\Orblit.Scene.csproj" />
    <ProjectReference Include="..\Orblit.Sequence\Orblit.Sequence.csproj" />
    <ProjectReference Include="..\Orblit.VectorMath\Orblit.VectorMath.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orblit.Motion.Tests" />
  </ItemGroup>
</Project>
