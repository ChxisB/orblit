<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Description>Every sound call a game makes, run without a speaker. A mixer with a bus tree, voices that fade and loop, and a listener that hears a positioned sound by distance, direction and Doppler. A backend only plays the result.</Description>
    <!-- Stop and Loop are the natural names. A Visual Basic caller can write [Stop] and [Loop]. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orblit.VectorMath\Orblit.VectorMath.csproj" />
  </ItemGroup>
</Project>
