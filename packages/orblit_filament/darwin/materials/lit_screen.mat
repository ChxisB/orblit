// A screen that is lit.
//
// video.mat is unlit: the picture is the light. This one is for the screen in
// a room, which catches the lamp and takes a reflection of the window as well
// as showing the picture. The frame is the base colour, so every light in the
// scene shades it, and the emissive term is how much the screen glows on its
// own.
//
// The sampler is external, exactly as in video.mat, so the frame is still the
// buffer the producer wrote and nothing is copied. That is also why this is a
// material of its own. An external sampler is a different sampler type in the
// shader and cannot be bound where lit.mat declares a sampler2d. The cost is
// one package, opaque only, with none of lit.mat's maps, decals, area lights,
// field, blending or wind.
//
// Parameter names match lit.mat where they mean the same thing, so
// Renderer::write sets them the same way.
material {
    name : orblitLitScreen,
    shadingModel : lit,
    blending : opaque,
    doubleSided : true,
    specularAntiAliasing : true,
    requires : [ uv0 ],
    parameters : [
        { type : float4,          name : baseColor },
        { type : float,           name : metallic },
        { type : float,           name : roughness },
        { type : float,           name : reflectance },
        { type : float3,          name : emissive },
        { type : float,           name : emissiveIntensity },
        { type : float,           name : ambientOcclusion },
        { type : float4,          name : uvTransform },
        { type : mat3,            name : orientation },
        { type : samplerExternal, name : videoTexture },
        { type : bool,            name : hasVideo }
    ],
}

fragment {
    // The frame is sRGB and lighting is done in linear light, so it is decoded
    // here as resolve_feed.mat does.
    vec3 toLinear(vec3 c) {
        vec3 low = c / 12.92;
        vec3 high = pow((c + 0.055) / 1.055, vec3(2.4));
        return mix(high, low, vec3(lessThanEqual(c, vec3(0.04045))));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0() * materialParams.uvTransform.xy
                + materialParams.uvTransform.zw;
        // See video.mat: from the upright picture to the frame, the identity
        // for a file.
        uv = (materialParams.orientation * vec3(uv, 1.0)).xy;

        vec4 frame = vec4(1.0);
        if (materialParams.hasVideo) {
            frame = texture(materialParams_videoTexture, uv);
            frame.rgb = toLinear(frame.rgb);
        }
        material.baseColor = materialParams.baseColor * frame;
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;
        material.ambientOcclusion = materialParams.ambientOcclusion;
        material.emissive = vec4(
            materialParams.emissive * materialParams.emissiveIntensity, 1.0);
    }
}
