<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe opens no console window on Windows. Elsewhere it is the same as Exe. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Orblit.Editor.App</RootNamespace>
    <!-- The compiler packages carry their messages in a dozen languages. The editor is in English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <!-- The font license asks for its text to travel with the font files. -->
    <None Include="Assets/Fonts/LICENSE.Geist.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Orblit.Editor.Bridge/Orblit.Editor.Bridge.csproj" />
    <InternalsVisibleTo Include="Orblit.Editor.App.Tests" />
    <InternalsVisibleTo Include="Orblit.Editor.Live" />
    <InternalsVisibleTo Include="Orblit.Editor.Layout.Checks" />
  </ItemGroup>

</Project>
