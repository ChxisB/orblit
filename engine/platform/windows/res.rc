#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

ORBLIT_ICON ICON platform/windows/orblit.ico
1 RT_MANIFEST "platform/windows/orblit.manifest"

1 VERSIONINFO
FILEVERSION     ORBLIT_VERSION_MAJOR,ORBLIT_VERSION_MINOR,ORBLIT_VERSION_PATCH,0
PRODUCTVERSION  ORBLIT_VERSION_MAJOR,ORBLIT_VERSION_MINOR,ORBLIT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Orblit Engine"
            VALUE "FileDescription",        ORBLIT_VERSION_NAME
            VALUE "FileVersion",            ORBLIT_VERSION_NUMBER
            VALUE "ProductName",            ORBLIT_VERSION_NAME
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "(c) 2026-present Orblit Engine contributors"
            VALUE "Info",                   "https://orblitengine.com"
            VALUE "ProductVersion",         ORBLIT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
