#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

ORBLIT_ICON ICON platform/windows/console.ico
1 RT_MANIFEST "platform/windows/orblit.manifest"

1 VERSIONINFO
FILEVERSION     ORBLIT_VERSION_MAJOR,ORBLIT_VERSION_MINOR,ORBLIT_VERSION_PATCH,0
PRODUCTVERSION  ORBLIT_VERSION_MAJOR,ORBLIT_VERSION_MINOR,ORBLIT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",        ORBLIT_VERSION_NAME " (Console)"
            VALUE "FileVersion",            ORBLIT_VERSION_NUMBER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
