#!/usr/bin/env python
from dist.utility.scons_hints import *

Import("env")
Import("env_modules")

freetype_enabled = "freetype" in env.module_list
msdfgen_enabled = "msdfgen" in env.module_list

env_text_system_fallback = env_modules.Clone()

if "svg" in env.module_list:
    env_text_system_fallback.Prepend(
        CPPPATH=["#thirdparty/thorvg/inc", "#thirdparty/thorvg/src/common", "#thirdparty/thorvg/src/renderer"]
    )
    # Enable ThorVG static object linking.
    env_text_system_fallback.Append(CPPDEFINES=["TVG_STATIC"])

if env["builtin_msdfgen"] and msdfgen_enabled:
    env_text_system_fallback.Append(CPPDEFINES=[("MSDFGEN_PUBLIC", "")])
    env_text_system_fallback.Prepend(CPPPATH=["#thirdparty/msdfgen"])

if env["builtin_freetype"] and freetype_enabled:
    env_text_system_fallback.Append(CPPDEFINES=["FT_CONFIG_OPTION_USE_BROTLI"])
    env_text_system_fallback.Prepend(CPPPATH=["#thirdparty/freetype/include"])

env_text_system_fallback.add_source_files(env.modules_sources, "*.cpp")
