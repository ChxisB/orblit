    [
        "make_ltc_lut.py",
        "#engine/systems/rendering/storage/ltc/ltc_lut1.dds",
        "#engine/systems/rendering/storage/ltc/ltc_lut2.dds",
    ],
    env.Run(make_ltc_lut.run),
)
