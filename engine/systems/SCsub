#!/usr/bin/env python
from dist.utility.scons_hints import *

Import("env")

env.systems_sources = []

env.add_source_files(env.systems_sources, "register_system_types.cpp")

SConscript("audio/SCsub")
SConscript("camera/SCsub")
SConscript("debugger/SCsub")
SConscript("display/SCsub")
SConscript("movie_writer/SCsub")
SConscript("rendering/SCsub")
SConscript("text/SCsub")
SConscript("navigation_planar/SCsub")
SConscript("physics_planar/SCsub")
SConscript("navigation_spatial/SCsub")
SConscript("physics_spatial/SCsub")
SConscript("xr/SCsub")

lib = env.add_library("systems", env.systems_sources)

env.Prepend(LIBS=[lib])
