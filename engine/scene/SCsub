#!/usr/bin/env python
from dist.utility.scons_hints import *

Import("env")

env.scene_sources = []

# Orblit source files
env.add_source_files(env.scene_sources, "*.cpp")

# Chain load SCsubs
SConscript("stage/SCsub")
SConscript("ui/SCsub")
if not env["disable_planar"]:
    SConscript("planar/SCsub")
if not env["disable_spatial"]:
    SConscript("spatial/SCsub")
SConscript("animation/SCsub")
SConscript("audio/SCsub")
SConscript("resources/SCsub")
SConscript("debugger/SCsub")
SConscript("theme/SCsub")

# Build it all as a library
lib = env.add_library("scene", env.scene_sources)
env.Prepend(LIBS=[lib])
