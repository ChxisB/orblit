#!/usr/bin/env python
from dist.utility.scons_hints import *

Import("env")

env.add_source_files(env.scene_sources, "*.cpp")

# Chain load SCsubs
if not env["disable_physics_spatial"]:
    SConscript("physics/SCsub")
if not env["disable_navigation_spatial"]:
    SConscript("navigation/SCsub")
if not env["disable_xr"]:
    SConscript("xr/SCsub")
